// A repository that is already static: HTML, CSS and JS with no build step.
//
//   cp this to <repo>/wrangler.jsonc, set "name" and "assets.directory",
//   then: npx wrangler deploy
//
// "name" becomes the hostname: <name>.<your-subdomain>.workers.dev.
{
  "name": "CHANGE-ME",
  "compatibility_date": "2025-09-01",
  "assets": {
    // "." for a repo whose index.html is at the root; "software" for jibewa.
    "directory": "./CHANGE-ME",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
